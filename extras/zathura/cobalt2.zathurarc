# Cobalt2 color theme for Zathura
# Swaps Foreground for Background to get a light version if the user prefers
#
# Cobalt2 color theme
#
set notification-error-bg "#ff628c"
set notification-error-fg "#ffffff"
set notification-warning-bg "#ffc600"
set notification-warning-fg "#0050a4"
set notification-bg "#193549"
set notification-fg "#ffffff"
set completion-bg "#193549"
set completion-fg "#e1efff"
set completion-group-bg "#193549"
set completion-group-fg "#e1efff"
set completion-highlight-bg "#0050a4"
set completion-highlight-fg "#ffffff"
set index-bg "#193549"
set index-fg "#ffffff"
set index-active-bg "#0050a4"
set index-active-fg "#ffffff"
set inputbar-bg "#193549"
set inputbar-fg "#ffffff"
set statusbar-bg "#193549"
set statusbar-fg "#ffffff"
set highlight-color "#ffc600"
set highlight-active-color "#a5ff90"
set default-bg "#193549"
set default-fg "#ffffff"
set render-loading true
set render-loading-fg "#193549"
set render-loading-bg "#ffffff"
#
# Recolor mode settings
# <C-r> to switch modes
#
set recolor-lightcolor "#193549"
set recolor-darkcolor "#ffffff"
